{
  "rules": {
    ".read": false,
    ".write": false,
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$name.matches(/^[a-z0-9_]{3,16}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "grafiti": {
      "saves": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['xp','money']) && newData.child('xp').isNumber() && newData.child('money').isNumber()"
        }
      },
      "walls": {
        ".read": "auth != null",
        "$city": {
          "$wall": {
            ".write": "auth != null",
            "$id": {
              ".validate": "newData.hasChildren(['u','s','t']) && newData.child('u').val() === auth.uid && newData.child('s').isString() && newData.child('s').val().length <= 24000"
            }
          }
        }
      },
      "repeat": {
        ".read": "auth != null",
        "$city": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || !newData.exists())",
            ".validate": "!newData.exists() || (newData.hasChildren(['u','s','t']) && newData.child('t').isNumber() && (data.exists() || !newData.child('r').exists()) && newData.child('s').isString() && newData.child('s').val().length <= 24000 && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 16)))",
            "r": {
              "$ru": {
                ".write": "auth != null && auth.uid === $ru && data.parent().parent().exists() && data.parent().parent().child('u').val() !== auth.uid",
                ".validate": "newData.hasChildren(['a','t']) && newData.child('a').isNumber() && newData.child('a').val() >= 0 && newData.child('a').val() <= 100"
              }
            }
          }
        }
      }
    },
    "skola": {
      "saves": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['xp','lessons']) && newData.child('xp').isNumber()"
        }
      }
    },
    "ap": {
      "saves": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['xp','calls']) && newData.child('xp').isNumber()"
        }
      }
    },
    "wallet": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() > -1000000 && newData.val() < 100000000"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['xp','money']) && newData.child('xp').isNumber() && newData.child('money').isNumber()"
      }
    },
    "stats": {
      ".read": true,
      ".indexOn": [
        "level",
        "xp"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','level','xp']) && newData.child('level').isNumber() && newData.child('level').val() >= 1 && newData.child('level').val() <= 99 && newData.child('name').isString() && newData.child('name').val().length <= 16 && root.child('usernames/'+newData.child('name').val().toLowerCase()).val() === auth.uid && (!newData.child('nick').exists() || (newData.child('nick').isString() && newData.child('nick').val().length >= 2 && newData.child('nick').val().length <= 16))"
      }
    },
    "presence": {
      "$city": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n','x','t']) && newData.child('n').isString() && root.child('usernames/'+newData.child('n').val().toLowerCase()).val() === $uid && (!newData.child('nk').exists() || (newData.child('nk').isString() && newData.child('nk').val().length >= 2 && newData.child('nk').val().length <= 16))"
        }
      }
    },
    "fcm": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "roles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid)",
        ".validate": "newData.val() === 'mod'"
      }
    },
    "kicks": {
      ".read": "auth != null && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || root.child('roles/'+auth.uid).val() === 'mod')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && $uid !== root.child('usernames/tailerboi').val() && $uid !== root.child('usernames/rihardsgod').val() && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || (root.child('roles/'+auth.uid).val() === 'mod' && root.child('roles/'+$uid).val() !== 'mod'))",
        ".validate": "!newData.exists() || newData.hasChildren(['by','until','t'])"
      }
    },
    "ideas": {
      ".read": "auth != null && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || root.child('roles/'+auth.uid).val() === 'mod')",
      "$id": {
        ".write": "(auth != null && !data.exists() && newData.child('uid').val() === auth.uid) || (auth != null && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || root.child('roles/'+auth.uid).val() === 'mod') && !newData.exists())",
        ".validate": "newData.hasChildren(['uid','name','text','t']) && newData.child('text').isString() && newData.child('text').val().length >= 3 && newData.child('text').val().length <= 500"
      }
    },
    "online": {
      ".read": "auth != null && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || root.child('roles/'+auth.uid).val() === 'mod')",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['game','t'])"
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friendReq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to || (auth.uid === $from && !root.child('blocks/'+$to+'/'+$from).exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['n','t']) && newData.child('n').isString() && newData.child('n').val().length <= 16)"
        }
      }
    },
    "friends": {
      "$u": {
        ".read": "auth != null && auth.uid === $u",
        "$f": {
          ".write": "auth != null && (auth.uid === $u || (auth.uid === $f && (!newData.exists() || root.child('friendReq/'+auth.uid+'/'+$u).exists())))",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "dm": {
      "$cid": {
        ".read": "auth != null && ($cid.beginsWith(auth.uid+'_') || $cid.endsWith('_'+auth.uid))",
        "$mid": {
          ".write": "auth != null && ($cid.beginsWith(auth.uid+'_') || $cid.endsWith('_'+auth.uid)) && !data.exists() && newData.child('f').val() === auth.uid && !root.child('blocks/'+$cid.replace(auth.uid,'').replace('_','')+'/'+auth.uid).exists()",
          ".validate": "newData.hasChildren(['f','x','t']) && newData.child('x').isString() && newData.child('x').val().length >= 1 && newData.child('x').val().length <= 300"
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $other && !root.child('blocks/'+$uid+'/'+$other).exists()))",
          ".validate": "!newData.exists() || newData.hasChildren(['n','x','t'])"
        }
      }
    },
    "chat": {
      "$city": {
        ".read": "auth != null",
        "$mid": {
          ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
          ".validate": "newData.hasChildren(['u','n','p','t']) && newData.child('p').isNumber() && newData.child('p').val() >= 0 && newData.child('p').val() < 40 && newData.child('n').isString() && newData.child('n').val().length <= 16"
        }
      }
    },
    "reports": {
      ".read": "auth != null && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || root.child('roles/'+auth.uid).val() === 'mod')",
      "$id": {
        ".write": "(auth != null && !data.exists() && newData.child('by').val() === auth.uid) || (auth != null && ((root.child('usernames/tailerboi').val() === auth.uid || root.child('usernames/rihardsgod').val() === auth.uid) || root.child('roles/'+auth.uid).val() === 'mod') && !newData.exists())",
        ".validate": "newData.hasChildren(['by','about','t'])"
      }
    },
    "ach": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$id": {
          ".validate": "$id.matches(/^[a-z0-9]{2,12}$/) && newData.isNumber()"
        }
      }
    },
    "invites": {
      "$inv": {
        ".read": "auth != null && auth.uid === $inv",
        "$new": {
          ".write": "auth != null && auth.uid === $new && $new !== $inv && !data.exists()",
          ".validate": "newData.hasChildren(['n','t']) && newData.child('n').isString() && newData.child('n').val().length <= 16"
        }
      }
    }
  }
}
